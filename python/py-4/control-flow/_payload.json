[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-PY_4":3},"# ═══════════════════════════════════════════\n# 1. if \u002F elif \u002F else\n# ═══════════════════════════════════════════\n\nscore = 86\nif score >= 90:\n    grade = \"A\"\nelif score >= 80:\n    grade = \"B\"\nelif score >= 60:\n    grade = \"C\"\nelse:\n    grade = \"D\"\nprint(grade)               # 结果：B\n\n# ═══════════════════════════════════════════\n# 2. 真值判断：任意对象都能当真假\n# ═══════════════════════════════════════════\n\nprint(bool(0), bool(\"\"), bool([]), bool({}))  # 结果：False False False False\nprint(bool([0]), bool(\"0\"))                    # 结果：True True，非空即为真\nitems = []\nprint(\"空\" if not items else \"非空\")            # 结果：空\n\n# ═══════════════════════════════════════════\n# 3. for + range（不含 stop）\n# ═══════════════════════════════════════════\n\ntotal = 0\nfor i in range(1, 5):      # 得到 1, 2, 3, 4，不含 5\n    total += i\nprint(total)               # 结果：10\nprint(list(range(0, 10, 3)))  # 结果：[0, 3, 6, 9]，带步长\n\n# ═══════════════════════════════════════════\n# 4. while 循环\n# ═══════════════════════════════════════════\n\nn = 3\nwhile n > 0:\n    print(n)               # 结果：3 2 1\n    n -= 1                 # 让条件趋于为假，否则死循环\n\n# ═══════════════════════════════════════════\n# 5. break 与循环的 else 子句\n# ═══════════════════════════════════════════\n\nfor i in range(10):\n    if i == 3:\n        break\nelse:\n    print(\"未触发 break\")   # 结果：不执行，循环被 break 打断\n\nfor _ in range(3):\n    pass\nelse:\n    print(\"循环正常结束\")   # 结果：循环正常结束\n\n# ═══════════════════════════════════════════\n# 6. continue\n# ═══════════════════════════════════════════\n\nfor i in range(5):\n    if i % 2 == 0:\n        continue           # 跳过偶数\n    print(i)               # 结果：1 3\n\n# ═══════════════════════════════════════════\n# 7. enumerate 与 zip\n# ═══════════════════════════════════════════\n\nfor idx, name in enumerate([\"a\", \"b\"]):\n    print(idx, name)       # 结果：0 a \u002F 1 b\nfor x, y in zip([1, 2], [\"a\", \"b\"]):\n    print(x, y)            # 结果：1 a \u002F 2 b\n",1792120314617]