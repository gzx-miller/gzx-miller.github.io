[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-PY_7":3},"# ═══════════════════════════════════════════\n# 1. 列表推导式\n# ═══════════════════════════════════════════\n\nsquares = [x * x for x in range(6)]\nprint(squares)             # 结果：[0, 1, 4, 9, 16, 25]\n\n# ═══════════════════════════════════════════\n# 2. 带条件过滤\n# ═══════════════════════════════════════════\n\nevens = [x for x in range(10) if x % 2 == 0]\nprint(evens)               # 结果：[0, 2, 4, 6, 8]\n\n# ═══════════════════════════════════════════\n# 3. 嵌套推导（笛卡尔积）\n# ═══════════════════════════════════════════\n\npairs = [(x, y) for x in range(2) for y in range(2)]\nprint(pairs)               # 结果：[(0, 0), (0, 1), (1, 0), (1, 1)]\n\n# ═══════════════════════════════════════════\n# 4. 字典推导式\n# ═══════════════════════════════════════════\n\nlengths = {w: len(w) for w in [\"a\", \"bb\", \"ccc\"]}\nprint(lengths)             # 结果：{'a': 1, 'bb': 2, 'ccc': 3}\n\n# ═══════════════════════════════════════════\n# 5. 集合推导式\n# ═══════════════════════════════════════════\n\nmods = {x % 3 for x in range(6)}\nprint(mods)                # 结果：{0, 1, 2}，自动去重\n\n# ═══════════════════════════════════════════\n# 6. 生成器表达式与惰性求值\n# ═══════════════════════════════════════════\n\ngen = (x * x for x in range(5))\nprint(next(gen))           # 结果：0\nprint(next(gen))           # 结果：1\nprint(list(gen))           # 结果：[4, 9, 16]，前面的已被取走\n\n# ═══════════════════════════════════════════\n# 7. iter \u002F next 手动迭代\n# ═══════════════════════════════════════════\n\nit = iter([10, 20])\nprint(next(it))            # 结果：10\nprint(next(it))            # 结果：20\ntry:\n    next(it)               # 已耗尽\nexcept StopIteration:\n    print(\"迭代结束\")       # 结果：迭代结束\n",1792738151307]