[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-PY_2":3},"# ═══════════════════════════════════════════\n# 1. 算术与整除\n# ═══════════════════════════════════════════\n\nprint(7 + 2)        # 结果：9\nprint(7 \u002F 2)        # 结果：3.5，\u002F 恒为 float\nprint(7 \u002F\u002F 2)       # 结果：3，向下取整的整除\nprint(7.0 \u002F\u002F 2)     # 结果：3.0，带 float 则结果为 float\nprint(divmod(7, 2))  # 结果：(3, 1)，一次拿到商与余数\n\n# ═══════════════════════════════════════════\n# 2. 取余的符号跟随除数\n# ═══════════════════════════════════════════\n\nprint(7 % 3)        # 结果：1\nprint(-7 % 3)       # 结果：2，余数符号跟随除数\nprint(7 % -3)       # 结果：-2\nprint(-7 \u002F\u002F 2, -7 % 2)  # 结果：-4 1，满足 (-4) * 2 + 1 == -7\n\n# ═══════════════════════════════════════════\n# 3. 幂运算（右结合）\n# ═══════════════════════════════════════════\n\nprint(2 ** 10)      # 结果：1024\nprint(2 ** -1)      # 结果：0.5，负指数返回 float\nprint(2 ** 3 ** 2)  # 结果：512，等价于 2 ** (3 ** 2)\n\n# ═══════════════════════════════════════════\n# 4. 链式比较\n# ═══════════════════════════════════════════\n\nx = 5\nprint(0 \u003C x \u003C 10)   # 结果：True\nprint(0 \u003C x \u003C 3)    # 结果：False\nprint(1 \u003C= x \u003C= 5)  # 结果：True，x 只求值一次\n\n# ═══════════════════════════════════════════\n# 5. and \u002F or 的短路求值\n# ═══════════════════════════════════════════\n\ndef noisy():\n    print(\"副作用被执行了\")\n    return True\n\nprint(False and noisy())   # 结果：False，右侧不会执行\nprint(True or noisy())     # 结果：True，右侧不会执行\nprint(0 or \"默认值\")        # 结果：默认值，返回参与运算的对象本身\nprint(\"\" and \"不回执行\")    # 结果：，空串为假直接返回\n\n# ═══════════════════════════════════════════\n# 6. == 比较值，is 比较身份\n# ═══════════════════════════════════════════\n\na = [1, 2, 3]\nb = [1, 2, 3]\nprint(a == b)       # 结果：True，值相等\nprint(a is b)       # 结果：False，不是同一个对象\nprint(a is not None)  # 结果：True，判断 None 用 is\n\n# ═══════════════════════════════════════════\n# 7. 增强赋值\n# ═══════════════════════════════════════════\n\ncount = 1\ncount += 4          # 等价于 count = count + 4\ncount *= 3          # 等价于 count = count * 3\nprint(count)        # 结果：15\n\nnums = [1, 2]\nalias = nums\nalias += [3]        # 列表的 += 走 extend，就地修改\nprint(nums)         # 结果：[1, 2, 3]，原列表同样被改\n",1792120314555]