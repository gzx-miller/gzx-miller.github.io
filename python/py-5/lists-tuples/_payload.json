[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-PY_5":3},"# ═══════════════════════════════════════════\n# 1. 增删改查\n# ═══════════════════════════════════════════\n\nnums = [3, 1, 4]\nnums.append(1)             # 结果：[3, 1, 4, 1]\nnums.insert(0, 9)          # 结果：[9, 3, 1, 4, 1]\nnums.remove(1)             # 结果：[9, 3, 4, 1]，删第一个匹配项\nlast = nums.pop()          # 结果：last = 1，nums = [9, 3, 4]\nprint(last, nums)\n\n# ═══════════════════════════════════════════\n# 2. 排序：sort 就地 vs sorted 新建\n# ═══════════════════════════════════════════\n\nvals = [3, 1, 2]\nprint(sorted(vals))        # 结果：[1, 2, 3]，原列表不变\nprint(vals)                # 结果：[3, 1, 2]\nvals.sort(reverse=True)    # 就地排序，返回 None\nprint(vals)                # 结果：[3, 2, 1]\n\n# ═══════════════════════════════════════════\n# 3. sort(key=...) 自定义排序规则\n# ═══════════════════════════════════════════\n\nwords = [\"bbb\", \"a\", \"cc\"]\nwords.sort(key=len)        # 按长度排序\nprint(words)               # 结果：['a', 'cc', 'bbb']\n\n# ═══════════════════════════════════════════\n# 4. 切片与切片赋值\n# ═══════════════════════════════════════════\n\nseq = [0, 1, 2, 3, 4, 5]\nprint(seq[1:4])            # 结果：[1, 2, 3]，不含 stop\nprint(seq[::-1])           # 结果：[5, 4, 3, 2, 1, 0]\nseq[1:3] = [9, 9]          # 切片赋值，就地替换那一段\nprint(seq)                 # 结果：[0, 9, 9, 3, 4, 5]\n\n# ═══════════════════════════════════════════\n# 5. 元组不可变与解包\n# ═══════════════════════════════════════════\n\npoint = (3, 4)\nx, y = point               # 解包\nprint(x, y)                # 结果：3 4\n# point[0] = 9             # 取消注释会抛 TypeError：元组不可变\n\n# ═══════════════════════════════════════════\n# 6. 共享引用陷阱：[[0]*3]*3\n# ═══════════════════════════════════════════\n\ngrid = [[0] * 3] * 3       # 三行共享同一个内层列表\ngrid[0][0] = 1\nprint(grid)                # 结果：[[1, 0, 0], [1, 0, 0], [1, 0, 0]]\nsafe = [[0] * 3 for _ in range(3)]  # 推导式让每行独立\nsafe[0][0] = 1\nprint(safe)                # 结果：[[1, 0, 0], [0, 0, 0], [0, 0, 0]]\n\n# ═══════════════════════════════════════════\n# 7. 可变默认参数陷阱\n# ═══════════════════════════════════════════\n\ndef collect(item, box=[]):     # 默认列表只创建一次，被所有调用共享\n    box.append(item)\n    return box\n\nprint(collect(1))          # 结果：[1]\nprint(collect(2))          # 结果：[1, 2]，默认对象被复用\n\ndef collect_safe(item, box=None):  # 正确做法：用 None 兜底\n    if box is None:\n        box = []\n    box.append(item)\n    return box\n\nprint(collect_safe(1))     # 结果：[1]\nprint(collect_safe(2))     # 结果：[2]\n",1792738151265]