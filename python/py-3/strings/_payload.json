[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-PY_3":3},"# ═══════════════════════════════════════════\n# 1. 引号与转义\n# ═══════════════════════════════════════════\n\nprint('It\\'s ok')          # 结果：It's ok，转义单引号\nprint(\"line1\\nline2\")      # 结果：两行文本，\\n 是换行\nprint(\"tab\\there\")         # 结果：tab 与 here 之间有制表符\n\n# ═══════════════════════════════════════════\n# 2. f-string 的对齐与精度\n# ═══════════════════════════════════════════\n\nname, score = \"Ada\", 3.14159\nprint(f\"[{name:>6}]\")      # 结果：[   Ada]，右对齐宽 6\nprint(f\"[{name:\u003C6}]\")      # 结果：[Ada   ]，左对齐宽 6\nprint(f\"{score:.2f}\")      # 结果：3.14，保留两位小数\nprint(f\"{42:04d}\")         # 结果：0042，整数补零到 4 位\nprint(f\"{name} = {score:.2f}\")  # 结果：Ada = 3.14\n\n# ═══════════════════════════════════════════\n# 3. 索引与切片（负索引、正负步长）\n# ═══════════════════════════════════════════\n\ns = \"abcdef\"\nprint(s[0], s[-1])         # 结果：a f，负索引取末字符\nprint(s[1:4])              # 结果：bcd，不含 stop\nprint(s[:3], s[3:])        # 结果：abc def\nprint(s[::2])              # 结果：ace，步长 2\nprint(s[::-1])             # 结果：fedcba，负步长反转\n\n# ═══════════════════════════════════════════\n# 4. split 与 join\n# ═══════════════════════════════════════════\n\ncsv = \"a,b,c\"\nparts = csv.split(\",\")     # 结果：['a', 'b', 'c']\nprint(\"-\".join(parts))     # 结果：a-b-c\nprint(\"a b  c\".split())    # 结果：['a', 'b', 'c']，按连续空白切分\n\n# ═══════════════════════════════════════════\n# 5. strip \u002F replace \u002F startswith\n# ═══════════════════════════════════════════\n\nraw = \"  hi  \"\nprint(raw.strip())                     # 结果：hi，去掉首尾空白\nprint(\"aXbXc\".replace(\"X\", \"-\"))       # 结果：a-b-c\nprint(\"hello\".startswith(\"he\"))        # 结果：True\nprint(\"hello\".find(\"l\"))               # 结果：2，返回首次出现的位置\n\n# ═══════════════════════════════════════════\n# 6. 三引号多行\n# ═══════════════════════════════════════════\n\ntext = \"\"\"第一行\n第二行\"\"\"\nprint(text.count(\"\\n\") + 1)  # 结果：2，跨两行\n\n# ═══════════════════════════════════════════\n# 7. str 与 bytes（encode \u002F decode）\n# ═══════════════════════════════════════════\n\ndata = \"栗子\".encode(\"utf-8\")\nprint(type(data))            # 结果：\u003Cclass 'bytes'>\nprint(data)                  # 结果：b'\\xe6\\xa0\\x97\\xe5\\xad\\x90'\nprint(data.decode(\"utf-8\"))  # 结果：栗子，还原回文本\n",1792738151218]