[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-E_6":3},"\u003Cscript setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { ElPopover, ElButton, ElInput } from 'element-plus'\n\nconst searchKeyword = ref('')\n\nconst courseList = [\n  'Vue3 组合式 API 入门',\n  'TypeScript 类型编程',\n  'Element Plus 组件精讲',\n  'Pinia 状态管理',\n  'Vite 构建优化',\n]\n\u003C\u002Fscript>\n\n\u003Ctemplate>\n  \u003Cdiv class=\"demo-card\">\n    \u003Ch3>气泡卡片 Popover\u003C\u002Fh3>\n\n    \u003Ch4>基础用法\u003C\u002Fh4>\n    \u003Cdiv class=\"button-row\">\n      \u003CElPopover\n        placement=\"top\"\n        title=\"标题\"\n        :width=\"200\"\n        trigger=\"hover\"\n      >\n        \u003Ctemplate #reference>\n          \u003CElButton>悬浮上方\u003C\u002FElButton>\n        \u003C\u002Ftemplate>\n        \u003Cp>这是一段内容，鼠标移出会自动关闭。\u003C\u002Fp>\n      \u003C\u002FElPopover>\n\n      \u003CElPopover\n        placement=\"bottom\"\n        title=\"快捷操作\"\n        :width=\"160\"\n        trigger=\"click\"\n      >\n        \u003Ctemplate #reference>\n          \u003CElButton type=\"primary\">点击下方\u003C\u002FElButton>\n        \u003C\u002Ftemplate>\n        \u003Cdiv class=\"action-list\">\n          \u003CElButton size=\"small\" link>新建课程\u003C\u002FElButton>\n          \u003CElButton size=\"small\" link>编辑资料\u003C\u002FElButton>\n          \u003CElButton size=\"small\" link type=\"danger\">退出登录\u003C\u002FElButton>\n        \u003C\u002Fdiv>\n      \u003C\u002FElPopover>\n\n      \u003CElPopover\n        placement=\"right\"\n        title=\"功能说明\"\n        :width=\"220\"\n        trigger=\"focus\"\n      >\n        \u003Ctemplate #reference>\n          \u003CElInput\n            v-model=\"searchKeyword\"\n            placeholder=\"聚焦此处\"\n          \u002F>\n        \u003C\u002Ftemplate>\n        \u003Cp>输入关键词后，系统会自动从课程库中搜索相关内容。\u003C\u002Fp>\n      \u003C\u002FElPopover>\n    \u003C\u002Fdiv>\n\n    \u003Ch4>嵌套内容\u003C\u002Fh4>\n    \u003CElPopover\n      placement=\"bottom-start\"\n      :width=\"240\"\n      trigger=\"click\"\n    >\n      \u003Ctemplate #reference>\n        \u003CElButton>课程列表\u003C\u002FElButton>\n      \u003C\u002Ftemplate>\n      \u003Ctemplate #default>\n        \u003Cdiv class=\"course-list\">\n          \u003Cp class=\"list-title\">推荐课程\u003C\u002Fp>\n          \u003Cdiv\n            v-for=\"course in courseList\"\n            :key=\"course\"\n            class=\"course-item\"\n          >\n            {{ course }}\n          \u003C\u002Fdiv>\n        \u003C\u002Fdiv>\n      \u003C\u002Ftemplate>\n    \u003C\u002FElPopover>\n  \u003C\u002Fdiv>\n\u003C\u002Ftemplate>\n\n",1788269092536]