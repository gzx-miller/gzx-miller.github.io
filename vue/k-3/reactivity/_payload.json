[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-K_3":3},"\u003Cscript setup lang=\"ts\">\nimport { reactive, ref } from 'vue'\n\nconst count = ref(1)\nconst profile = reactive({\n  name: '林青',\n  level: '初级前端',\n})\n\nfunction promote() {\n  count.value += 1\n  profile.level = count.value > 3 ? 'Vue3 熟练者' : '初级前端'\n}\n\u003C\u002Fscript>\n\n\u003Ctemplate>\n  \u003Cdiv class=\"demo-card\">\n    \u003Ch3>{{ profile.name }} 的学习进度\u003C\u002Fh3>\n    \u003Cp>完成章节：{{ count }}\u003C\u002Fp>\n    \u003Cp>当前阶段：{{ profile.level }}\u003C\u002Fp>\n    \u003Cbutton @click=\"promote\">完成一章\u003C\u002Fbutton>\n  \u003C\u002Fdiv>\n\u003C\u002Ftemplate>\n",1788269097432]