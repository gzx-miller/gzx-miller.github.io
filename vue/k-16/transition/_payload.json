[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-K_16":3},"\u003Cscript setup lang=\"ts\">\nimport { ref } from 'vue'\n\nconst showTip = ref(true)\nconst goals = ref(['读完 🌰16', '写一个过渡动画'])\n\u003C\u002Fscript>\n\n\u003Ctemplate>\n  \u003Cdiv class=\"demo-card\">\n    \u003Ch3>学习提醒\u003C\u002Fh3>\n    \u003Cbutton @click=\"showTip = !showTip\">切换提示\u003C\u002Fbutton>\n    \u003CTransition name=\"fade\">\n      \u003Cp v-if=\"showTip\">过渡用于让进入和离开的 DOM 有状态变化。\u003C\u002Fp>\n    \u003C\u002FTransition>\n    \u003CTransitionGroup name=\"list\" tag=\"ul\">\n      \u003Cli v-for=\"goal in goals\" :key=\"goal\">{{ goal }}\u003C\u002Fli>\n    \u003C\u002FTransitionGroup>\n  \u003C\u002Fdiv>\n\u003C\u002Ftemplate>\n",1788269097195]