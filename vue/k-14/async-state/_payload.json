[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-K_14":3},"\u003Cscript setup lang=\"ts\">\nimport { onMounted, ref } from 'vue'\n\nconst loading = ref(false)\nconst error = ref('')\nconst lessons = ref\u003Cstring[]>([])\n\nasync function loadLessons() {\n  loading.value = true\n  error.value = ''\n  lessons.value = []\n\n  try {\n    await new Promise((resolve) => window.setTimeout(resolve, 500))\n    lessons.value = ['组合式 API', '路由守卫', 'Pinia 状态管理']\n  } catch {\n    error.value = '课程列表加载失败'\n  } finally {\n    loading.value = false\n  }\n}\n\nonMounted(loadLessons)\n\u003C\u002Fscript>\n\n\u003Ctemplate>\n  \u003Cdiv class=\"demo-card\">\n    \u003Ch3>异步课程列表\u003C\u002Fh3>\n    \u003Cbutton @click=\"loadLessons\">重新加载\u003C\u002Fbutton>\n    \u003Cp v-if=\"loading\">加载中...\u003C\u002Fp>\n    \u003Cp v-else-if=\"error\">{{ error }}\u003C\u002Fp>\n    \u003Cul v-else>\n      \u003Cli v-for=\"lesson in lessons\" :key=\"lesson\">{{ lesson }}\u003C\u002Fli>\n    \u003C\u002Ful>\n  \u003C\u002Fdiv>\n\u003C\u002Ftemplate>\n",1788269097166]