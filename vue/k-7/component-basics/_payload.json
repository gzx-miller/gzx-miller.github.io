[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-K_7":3},"\u003Cscript setup lang=\"ts\">\nimport { ref } from 'vue'\n\nconst props = defineProps\u003C{\n  title?: string\n}>()\n\nconst emit = defineEmits\u003C{\n  saved: [value: string]\n}>()\n\nconst draft = ref(props.title ?? 'Vue3 组件卡片')\nconst savedTitle = ref(draft.value)\n\nfunction save() {\n  savedTitle.value = draft.value\n  emit('saved', draft.value)\n}\n\u003C\u002Fscript>\n\n\u003Ctemplate>\n  \u003Cdiv class=\"demo-card\">\n    \u003Ch3>{{ savedTitle }}\u003C\u002Fh3>\n    \u003Cinput v-model=\"draft\" aria-label=\"标题\" \u002F>\n    \u003Cbutton @click=\"save\">保存标题\u003C\u002Fbutton>\n  \u003C\u002Fdiv>\n\u003C\u002Ftemplate>\n",1788269097614]