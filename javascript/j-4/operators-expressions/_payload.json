[{"data":1,"prerenderedAt":4},["ShallowReactive",2],{"lesson-code-J_04":3},"\u002F\u002F ═══════════════════════════════════════════\n\u002F\u002F 1. 算术运算符\n\u002F\u002F ═══════════════════════════════════════════\n\n7 % 3             \u002F\u002F 1  —— 取余\n-7 % 3            \u002F\u002F -1 —— 结果的符号跟随被除数\n2 ** 3            \u002F\u002F 8  —— 幂运算\n2 ** 3 ** 2       \u002F\u002F 512 —— ** 右结合，等价于 2 ** (3 ** 2)\n\nlet i = 5\nconst pre = ++i   \u002F\u002F pre 为 6，i 为 6 —— 前置：先加再用\nconst post = i++  \u002F\u002F post 为 6，i 为 7 —— 后置：先用再加\n\n0.1 + 0.2 === 0.3 \u002F\u002F false —— 浮点精度问题\n\n\u002F\u002F ═══════════════════════════════════════════\n\u002F\u002F 2. 比较与字符串比较\n\u002F\u002F ═══════════════════════════════════════════\n\n'2' > '10'        \u002F\u002F true  —— 字符串逐位比较，先比首字符 '2' > '1'\n'b' > 'a'         \u002F\u002F true\n[1, 2] \u003C [1, 3]   \u002F\u002F true  —— 转成 '1,2' 与 '1,3' 再比较\n'5' \u003C 3           \u002F\u002F false —— 两侧先转成数字，5 \u003C 3\n\n\u002F\u002F ═══════════════════════════════════════════\n\u002F\u002F 3. 逻辑运算返回的是操作数\n\u002F\u002F ═══════════════════════════════════════════\n\n0 || 'x'          \u002F\u002F 'x'   —— 左侧是假值，返回右侧操作数\n'a' && 'b'        \u002F\u002F 'b'   —— 左侧是真值，返回右侧操作数\n'' || 'default'   \u002F\u002F 'default' —— 空字符串被当成假值\n0 ?? 'default'    \u002F\u002F 0     —— ?? 只对 null\u002Fundefined 兜底\nfalse || 0        \u002F\u002F 0     —— || 会跳过 false，把 0 当兜底值\n\n\u002F\u002F ═══════════════════════════════════════════\n\u002F\u002F 4. 可选链与空值合并\n\u002F\u002F ═══════════════════════════════════════════\n\nconst user = { profile: { bio: '收集栗子' }, list: [] }\nuser?.address?.city       \u002F\u002F undefined —— 链上缺失也不报错\nuser?.profile?.bio        \u002F\u002F '收集栗子'\nuser?.list?.[0]           \u002F\u002F undefined —— 可选索引\nuser?.save?.()            \u002F\u002F undefined —— 函数不存在时不调用，也不报错\n\n\u002F\u002F ═══════════════════════════════════════════\n\u002F\u002F 5. 逻辑赋值\n\u002F\u002F ═══════════════════════════════════════════\n\nlet title\ntitle ??= '默认标题'      \u002F\u002F '默认标题' —— 空值才赋值\nlet count = 0\ncount ||= 5               \u002F\u002F 5 —— 假值就赋值（0 被覆盖）\nlet flag = true\nflag &&= false            \u002F\u002F false —— 真值才赋值\n\n\u002F\u002F ═══════════════════════════════════════════\n\u002F\u002F 6. 位运算与权限标志\n\u002F\u002F ═══════════════════════════════════════════\n\nconst READ  = 0b001       \u002F\u002F 1\nconst WRITE = 0b010       \u002F\u002F 2\nconst ADMIN = 0b100       \u002F\u002F 4\n\nlet perms = 0\nperms |= READ             \u002F\u002F 1  —— 按位或：授予读权限\nperms |= WRITE            \u002F\u002F 3  —— 继续授予写权限\nperms & READ              \u002F\u002F 1  —— 按位与：非 0 即拥有读权限\nperms & ~WRITE            \u002F\u002F 1  —— 与非：撤销写权限\nperms ^ ADMIN             \u002F\u002F 7  —— 异或：切换管理权限\n\n5 & 3                     \u002F\u002F 1  —— 101 & 011\n5 | 3                     \u002F\u002F 7  —— 101 | 011\n5 ^ 3                     \u002F\u002F 6  —— 101 ^ 011\n~5                        \u002F\u002F -6 —— 按位取反，先转为 32 位有符号整数\n1 \u003C\u003C 3                    \u002F\u002F 8  —— 左移三位\n-8 >> 1                   \u002F\u002F -4 —— 有符号右移，保留符号位\n-8 >>> 1                  \u002F\u002F 2147483644 —— 无符号右移，高位补 0\n",1792120312340]